 string url::get_path() const {
+#ifdef WIN32
+	if (m_scheme == "file" || m_scheme == "pac+file") {
+		string path = m_path;
+		if (!m_host.empty() && m_host != "localhost")
+			path = "//" + m_host + path;
+		else if (path.size() >= 3 && path[0] == '/' &&
+		         isalpha((unsigned char) path[1]) && path[2] == ':')
+			path.erase(0, 1);
+		else
+			return path;
+		replace(path.begin(), path.end(), '/', '\\');
+		return path;
+	}
+#endif
 	return m_path;
 }
 

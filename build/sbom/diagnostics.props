<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Import late via ForceImportAfterCppTargets; also works with old tags. -->
  <ItemDefinitionGroup Condition="'$(NativeTraceDirectory)' != ''">
    <Link>
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(NativeTraceDirectory)\$(MSBuildProjectName)-$(Platform).map</MapFileName>
      <AdditionalOptions>%(AdditionalOptions) /VERBOSE:LIB</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="CreateNativeTraceDirectory" BeforeTargets="Link" Condition="'$(NativeTraceDirectory)' != ''">
    <MakeDir Directories="$(NativeTraceDirectory)" />
  </Target>
</Project>
